mage_url","type":"object","required":false,"defaultValue":null,"description":"输入给模型的图片对象，当 type 为 image_url 时必选。","example":null,"location":"body"},{"name":"content[].image_url.url","type":"string","required":true,"defaultValue":null,"description":"图片 URL、Base64 编码或素材 ID。格式：jpeg、png、webp、bmp、tiff、gif、heic、heif（部分模型支持），宽高比(0.4,2.5)，像素(300,6000)，大小<30MB。","example":null,"location":"body"},{"name":"content[].role","type":"string","required":true,"defaultValue":null,"description":"图片/视频/音频的位置或用途，条件必填。图片：first_frame (首帧), last_frame (尾帧), reference_image (参考图)；视频：reference_video；音频：reference_audio。注意图生视频-首帧、首尾帧、多模态参考生视频互斥。","example":null,"location":"body"},{"name":"content[].video_url","type":"object","required":false,"defaultValue":null,"description":"输入给模型的视频对象，当 type 为 video_url 时必选。仅 Seedance 2.0 系列支持。","example":null,"location":"body"},{"name":"content[].video_url.url","type":"string","required":true,"defaultValue":null,"description":"视频 URL 或素材 ID。格式：mp4、mov，分辨率480p-4k，时长2-15s，宽高比[0.4,2.5]，像素[300,6000]，总像素[409600,8295044]，大小<200MB，帧率24-60。","example":null,"location":"body"},{"name":"content[].audio_url","type":"object","required":false,"defaultValue":null,"description":"输入给模型的音频对象，当 type 为 audio_url 时必选。仅 Seedance 2.0 系列支持，不可单独输入。","example":null,"location":"body"},{"name":"content[].audio_url.url","type":"string","required":true,"defaultValue":null,"description":"音频 URL、Base64 编码或素材 ID。格式：wav、mp3，时长2-15s，大小<15MB。","example":null,"location":"body"},{"name":"content[].draft_task","type":"object","required":false,"defaultValue":null,"description":"输入给模型的样片任务对象，当 type 为 draft_task 时必选。仅 Seedance 1.5 Pro 支持。","example":null,"location":"body"},{"name":"content[].draft_task.id","type":"string","required":true,"defaultValue":null,"description":"样片任务 ID。自动复用 Draft 输入的 model、content、generate_audio 等。","example":null,"location":"body"},{"name":"callback_url","type":"string","required":false,"defaultValue":null,"description":"视频生成任务状态变化时的回调通知地址。状态包括 queued, running, succeeded, failed, expired。","example":null,"location":"body"},{"name":"return_last_frame","type":"boolean","required":false,"defaultValue":"false","description":"是否返回生成视频的尾帧图像。true 时可通过查询接口获取 png 尾帧。","example":null,"location":"body"},{"name":"service_tier","type":"string","required":false,"defaultValue":"default","description":"处理请求的服务等级类型。枚举值：default (在线推理), flex (离线推理, 价格50%)。Seedance 2.0 仅支持 default。","example":null,"location":"body"},{"name":"execution_expires_after","type":"integer","required":false,"defaultValue":"172800","description":"任务超时阈值（秒），从 created at 开始计算。默认 172800（48小时），取值范围 [3600, 259200]。","example":null,"location":"body"},{"name":"generate_audio","type":"boolean","required":false,"defaultValue":"true","description":"控制生成视频是否包含同步音频。true 生成有声视频（单声道），false 无声。仅 Seedance 2.0 系列和 Seedance 1.5 Pro 支持。","example":null,"location":"body"},{"name":"draft","type":"boolean","required":false,"defaultValue":"false","description":"是否开启样片模式。true 生成低分辨率预览视频，消耗 token 少。仅 Seedance 1.5 Pro 支持。","example":null,"location":"body"},{"name":"tools","type":"array","required":false,"defaultValue":null,"description":"配置模型要调用的工具，仅 Seedance 2.0 系列支持。目前支持 web_search。","example":null,"location":"body"},{"name":"tools[].type","type":"string","required":false,"defaultValue":null,"description":"指定工具类型。枚举值：web_search（联网搜索）。","example":null,"location":"body"},{"name":"safety_identifier","type":"string","required":false,"defaultValue":null,"description":"终端用户唯一标识符，用于协助平台检测违规使用。长度不超过 64 字符，推荐使用哈希值。","example":null,"location":"body"},{"name":"priority","type":"integer","required":false,"defaultValue":"0","description":"请求执行优先级，0~9，数值越大优先级越高，仅同一 Endpoint 内生效。仅 Seedance 2.0 系列支持，离线推理不支持。","example":null,"location":"body"},{"name":"resolution","type":"string","required":false,"defaultValue":null,"description":"视频分辨率。枚举值：480p, 720p, 1080p, 4k。不同模型默认值不同（Seedance 2.0/1.5 Pro 默认 720p，1.0 系列默认 1080p）。4k 仅 Seedance 2.0 支持。","example":null,"location":"body"},{"name":"ratio","type":"string","required":false,"defaultValue":null,"description":"视频宽高比。枚举值：16:9, 4:3, 1:1, 3:4, 9:16, 21:9, adaptive。默认：Seedance 2.0/1.5 Pro 为 adaptive，其他模型文生视频默认 16:9，图生视频默认 adaptive。","example":null,"location":"body"},{"name":"duration","type":"integer","required":false,"defaultValue":"5","description":"视频时长（秒），仅支持整数。Seedance 1.0 Pro/Fast: [2,12]；Seedance 1.5 Pro: [4,12] 或 -1（智能指定）；Seedance 2.0: [4,15] 或 -1。与 frames 二选一，frames 优先级更高。","example":null,"location":"body"},{"name":"frames","type":"integer","required":false,"defaultValue":null,"description":"生成视频的帧数，Seedance 2.0/1.5 Pro 暂不支持。取值范围 [29, 289] 内满足格式 25+4n 的整数。与 duration 二选一。","example":null,"location":"body"},{"name":"seed","type":"integer","required":false,"defaultValue":"-1","description":"种子整数，控制生成内容的随机性，取值范围 [-1, 2^32-1]。Seedance 2.0 系列暂不支持。","example":null,"location":"body"},{"name":"camera_fixed","type":"boolean","required":false,"defaultValue":"false","description":"是否固定摄像头。true 固定摄像头（实际效果不保证）。参考图场景不支持，Seedance 2.0 系列暂不支持。","example":null,"location":"body"},{"name":"watermark","type":"boolean","required":false,"defaultValue":"false","description":"生成视频是否包含水印。true 则在右下角展示“AI 生成”水印。","example":null,"location":"body"}],"responseParams":[{"name":"id","type":"string","defaultValue":null,"description":"视频生成任务 ID，仅保存 7 天。draft 模式为 Draft 任务 ID，非 draft 为正式任务 ID。","example":null,"location":"body"}],"request":{"method":"POST","contentType":"application/json","modelField":"model","sampleBody":"{\n  \"model\": \"doubao-seedance-2-0-260128\",\n  \"content\": [\n    {\n      \"type\": \"\",\n      \"image_url\": {\n        \"url\": \"\"\n      },\n      \"role\": \"\",\n      \"video_url\": {\n        \"url\": \"\"\n      },\n      \"audio_url\": {\n        \"url\": \"\"\n      },\n      \"draft_task\": {\n        \"id\": \"\"\n      }\n    }\n  ]\n}"},"notes":["网关根据请求中的 model 字段匹配并转发到对应上游模型。","每个接口可独立配置网关路径、上游路径、请求方法和参数文档。","当前模型已上架，可通过网关接入。"],"samples":{"curl":"curl -X POST 'https://api.zhonghaicn.com/volcengine/api/v3/contents/generatio